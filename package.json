{
  "name": "pata-e-gestao",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.check.json",
    "check": "npm run typecheck && npm test",
    "deploy": "npm run check && vite build && firebase deploy --only hosting",
    "reset:dias": "powershell -ExecutionPolicy Bypass -File ./reset.ps1 dias",
    "reset:pets": "powershell -ExecutionPolicy Bypass -File ./reset.ps1 petsCadastro",
    "reset:contadores": "powershell -ExecutionPolicy Bypass -File ./reset.ps1 contadores",
    "reset:profissionais": "powershell -ExecutionPolicy Bypass -File ./reset.ps1 profissionais",
    "reset": "powershell -ExecutionPolicy Bypass -File ./reset.ps1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-tabs": "1.1.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "^12.12.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "recharts": "2.15.2",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "25.0.1",
    "tailwindcss": "4.1.12",
    "typescript": "^7.0.2",
    "vite": "6.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "3.2.7"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
