rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // —— Funções auxiliares ——————————————————————————————————————
    function isAuthenticated() {
      return request.auth != null;
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Funcionário = está logado E tem registro em /usuarios.
    // Conta criada por estranho (sem registro) não acessa nada.
    function isStaff() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function isAdmin() {
      return isStaff() && perfil().role == 'admin';
    }

    // NOVO: dono do sistema (Pata & Gestão). Marcado SÓ pelo console do Firebase.
    function isDono() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/donos/$(request.auth.uid));
    }

    // NOVO: funcionário DESTA loja / admin DESTA loja
    function daLoja(lojaId) {
      return isStaff() && perfil().lojaId == lojaId;
    }

    function adminDaLoja(lojaId) {
      return daLoja(lojaId) && perfil().role == 'admin';
    }

    // NOVO (alertas da ficha): lista de até 12 etiquetas curtas + detalhe de até 300 letras.
    // Vale para a ficha (petsCadastro) e para a cópia do pet na fila do dia.
    // As 3 primeiras etiquetas têm o tamanho conferido aqui; o app corta todas em 40 letras.
    function alertaCurto(a, i) {
      return a.size() <= i || (a[i] is string && a[i].size() > 0 && a[i].size() <= 40);
    }
    function alertasValidos(d) {
      return (!('alertas' in d)
              || (d.alertas is list && d.alertas.size() <= 12
                  && alertaCurto(d.alertas, 0) && alertaCurto(d.alertas, 1) && alertaCurto(d.alertas, 2)))
          && (!('alertaObs' in d)
              || (d.alertaObs is string && d.alertaObs.size() <= 300));
    }

    // —— Dono do sistema —————————————————————————————————————————
    match /donos/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isDono());
      // NOVO: um proprietário dá acesso a outro (sócio, desenvolvedor) pelo painel
      allow create: if isDono()
                    && request.resource.data.keys().hasOnly(['nome', 'email', 'criadoEm'])
                    && request.resource.data.nome is string
                    && request.resource.data.nome.size() > 0
                    && request.resource.data.nome.size() <= 100
                    && request.resource.data.email is string;
      allow update: if false;
      // ninguém tira o próprio acesso (sempre fica pelo menos um)
      allow delete: if isDono() && uid != request.auth.uid;
    }

    // —— Usuários ————————————————————————————————————————————————
    match /usuarios/{userId} {
      // cada um lê o próprio registro (login); o admin lê os da loja dele; o dono lê todos
      allow read: if isAuthenticated() && (
                    request.auth.uid == userId
                    || isDono()
                    || (isStaff() && resource.data.lojaId == perfil().lojaId));

      // admin cria funcionário só na loja dele; o dono cria o admin de uma loja nova
      allow create: if request.resource.data.role in ['admin', 'user']
                    && (isDono() || adminDaLoja(request.resource.data.lojaId));

      // admin edita os da loja dele (sem trocar de loja nem o próprio papel);
      // o dono pode ligar um funcionário a uma loja (migração)
      allow update: if request.resource.data.role in ['admin', 'user']
                    && (isDono()
                        || (adminDaLoja(resource.data.lojaId)
                            && request.resource.data.lojaId == resource.data.lojaId
                            && (userId != request.auth.uid
                                || request.resource.data.role == resource.data.role)));

      // primeiro acesso: a própria pessoa só tira a marca "trocar senha" depois de criar a senha dela
      allow update: if isAuthenticated() && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trocarSenha'])
                    && resource.data.get('trocarSenha', false) == true
                    && request.resource.data.trocarSenha == false;

      // admin exclui os da loja dele, menos a si mesmo
      allow delete: if userId != request.auth.uid
                    && (isDono() || adminDaLoja(resource.data.lojaId));
    }

    // —— Lojas (NOVO: cada loja tem seu espaço) ——————————————————
    match /lojas/{lojaId} {
      allow read: if isDono() || daLoja(lojaId);
      allow write: if isDono();

      // NOVO (Personalização): o admin da loja troca SÓ a logo e as cores do topo
      allow update: if adminDaLoja(lojaId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['logoUrl', 'cores', 'personalizadoEm'])
                    && (!('logoUrl' in request.resource.data)
                        || request.resource.data.logoUrl == resource.data.get('logoUrl', null)
                        || (request.resource.data.logoUrl is string
                            && request.resource.data.logoUrl.size() <= 500
                            && request.resource.data.logoUrl.matches('^https://res[.]cloudinary[.]com/.*')))
                    && (!('cores' in request.resource.data)
                        || (request.resource.data.cores.keys().hasOnly(['principal', 'destaque'])
                            && request.resource.data.cores.principal.matches('^#[0-9A-Fa-f]{6}$')
                            && request.resource.data.cores.destaque.matches('^#[0-9A-Fa-f]{6}$')));

      // o dono lê tudo de todas as lojas (painel) e grava na migração
      match /{documento=**} {
        allow read: if isDono();
        allow create, update: if isDono();
        allow delete: if isDono(); // NOVO: excluir a loja inteira
      }

      // NOVO (suporte ao vivo): a loja vê se o proprietário está acompanhando (só ele grava)...
      match /suporte/{documento} {
        allow read: if daLoja(lojaId);
      }
      // ...e, enquanto isso, cada aparelho conta a aba e a janela aberta
      match /telas/{aparelho} {
        allow create, update: if daLoja(lojaId)
                      && request.resource.data.keys().hasOnly(['nome', 'aba', 'janela', 'atualizadoEm'])
                      && request.resource.data.aba in ['grid', 'kanban', 'entregues'];
        allow delete: if daLoja(lojaId);
      }

      match /profissionais/{profissionalId} {
        allow read: if daLoja(lojaId);
        allow create, update, delete: if adminDaLoja(lojaId);
      }

      match /petsCadastro/{petNumber} {
        allow read: if daLoja(lojaId);
        allow create, update: if daLoja(lojaId)
                      && request.resource.data.petNumber == petNumber
                      && request.resource.data.nomePet is string
                      && request.resource.data.nomePet.size() > 0
                      && request.resource.data.nomePet.size() <= 100
                      && request.resource.data.nomeTutor is string
                      && request.resource.data.nomeTutor.size() <= 100
                      && alertasValidos(request.resource.data);
        allow delete: if adminDaLoja(lojaId);
      }

      match /racas/{racaId} {
        allow read: if daLoja(lojaId);
        allow create: if daLoja(lojaId)
                      && request.resource.data.keys().hasOnly(['nome', 'especie', 'criadoEm'])
                      && request.resource.data.nome is string
                      && request.resource.data.nome.size() > 0
                      && request.resource.data.nome.size() <= 60
                      && request.resource.data.especie in ['cao', 'gato'];
        allow update: if adminDaLoja(lojaId)
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['nome', 'atualizadoEm'])
                      && request.resource.data.nome is string
                      && request.resource.data.nome.size() > 0
                      && request.resource.data.nome.size() <= 60;
        allow delete: if adminDaLoja(lojaId);
      }

      // o contador só começa em 1 e sobe de 1 em 1 (ninguém volta o número)
      match /contadores/{contadorId} {
        allow read:   if daLoja(lojaId);
        allow create: if daLoja(lojaId) && request.resource.data.valor == 1;
        allow update: if daLoja(lojaId)
                      && request.resource.data.valor == resource.data.valor + 1;
        allow delete: if false;
      }

      match /slotsUsados/{dia} {
        allow read:           if daLoja(lojaId);
        allow create, update: if daLoja(lojaId) && request.resource.data.slots is list;
        allow delete:         if adminDaLoja(lojaId);
      }

      match /dias/{diaId} {
        allow read, create, update: if daLoja(lojaId);
        allow delete: if adminDaLoja(lojaId);

        match /pets/{petId} {
          allow read:   if daLoja(lojaId);
          allow create, update: if daLoja(lojaId)
                      && request.resource.data.slotNumber is int
                      && request.resource.data.slotNumber >= 1
                      && request.resource.data.slotNumber <= 100
                      && request.resource.data.status in
                           ['espera', 'banho', 'escovar', 'tosa', 'finalizado']
                      && request.resource.data.servico in
                           ['banho', 'tosa', 'banho_tosa', 'higienica', 'ozonio', 'hidratacao']
                      && request.resource.data.nomePet is string
                      && request.resource.data.nomePet.size() > 0
                      && request.resource.data.nomePet.size() <= 100
                      && alertasValidos(request.resource.data);
          allow delete: if daLoja(lojaId);
        }

        match /logs/{logId} {
          allow read:   if daLoja(lojaId);
          allow create: if daLoja(lojaId);
          // LGPD: só o admin, e só para trocar o nome do tutor por "Removido (LGPD)"
          allow update: if adminDaLoja(lojaId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nomeTutor'])
                      && request.resource.data.nomeTutor == 'Removido (LGPD)';
          allow delete: if adminDaLoja(lojaId);
        }
      }
    }

    // —— Portal do tutor (NOVO): link de acompanhamento do pet ——————————
    //    Sem login: quem tem o código lê SÓ aquele link, e só enquanto vale.
    //    Ninguém lista os links. Só a equipe da loja cria e avança as etapas.
    match /acompanhamentos/{codigo} {
      allow get: if resource.data.expiraEm > request.time.toMillis();
      allow list: if false;
      allow create: if daLoja(request.resource.data.lojaId)
                    && codigo.matches('^[A-Za-z0-9]{20,40}$')
                    && request.resource.data.keys().hasOnly([
                         'lojaId', 'nomeLoja', 'logoUrl', 'cores', 'nomePet', 'especie', 'servico', 'status', 'dia',
                         'expiraEm', 'atualizadoEm', 'chegouEm', 'banhoEm', 'escovarEm', 'tosaEm', 'prontoEm', 'entregueEm'])
                    && request.resource.data.nomePet is string
                    && request.resource.data.nomePet.size() > 0
                    && request.resource.data.nomePet.size() <= 100
                    && request.resource.data.expiraEm is int
                    && request.resource.data.expiraEm <= request.time.toMillis() + 3 * 24 * 60 * 60 * 1000;
      allow update: if daLoja(resource.data.lojaId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'status', 'atualizadoEm', 'chegouEm', 'banhoEm', 'escovarEm', 'tosaEm', 'prontoEm', 'entregueEm'])
                    && request.resource.data.status in
                         ['espera', 'banho', 'escovar', 'tosa', 'finalizado', 'entregue', 'removido'];
      allow delete: if isDono() || daLoja(resource.data.lojaId);
    }

    // —— Agendamento online (NOVO, módulo por loja) ——————————————————————
    //    O tutor não tem login: lê a agenda pública (sem dados de ninguém),
    //    marca uma vaga liberada pelo admin e cria o pedido no mesmo envio.
    //    O pedido (com nome e WhatsApp) só é lido por quem tem o código ou pela loja.
    function agendaAtiva(lojaId) {
      return get(/databases/$(database)/documents/agendaPublica/$(lojaId)).data.get('ativo', false) == true;
    }
    function lojaTemAgendamento(lojaId) {
      return get(/databases/$(database)/documents/lojas/$(lojaId)).data.get('modulos', {}).get('agendamento', false) == true;
    }
    function vagasOnline(lojaId, dia) {
      return get(/databases/$(database)/documents/agendaPublica/$(lojaId)/dias/$(dia)).data.vagas;
    }
    function textoAte(v, n) {
      return v is string && v.size() <= n;
    }

    match /agendaPublica/{lojaId} {
      allow get: if true;
      allow list: if false;
      // o proprietário liga/desliga; o admin só atualiza nome/logo/cores se a loja tiver o módulo
      allow create, update: if (isDono() || (adminDaLoja(lojaId) && lojaTemAgendamento(lojaId)))
                    && request.resource.data.keys().hasOnly(['ativo', 'nomeLoja', 'logoUrl', 'cores', 'atualizadoEm'])
                    && request.resource.data.ativo is bool
                    && textoAte(request.resource.data.nomeLoja, 100);
      allow delete: if isDono();

      match /dias/{dia} {
        allow read: if true;
        allow create, update: if (isDono() || adminDaLoja(lojaId))
                    && dia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.keys().hasOnly(['dia', 'vagas', 'atualizadoEm'])
                    && request.resource.data.dia == dia
                    && request.resource.data.vagas is list
                    && request.resource.data.vagas.size() <= 30;
        allow delete: if isDono() || adminDaLoja(lojaId);

        // trava de cada vaga marcada: só a data, nenhum dado do tutor
        match /marcadas/{vaga} {
          allow read: if true;
          allow create: if agendaAtiva(lojaId)
                    && vaga.matches('^[0-9]{1,3}$')
                    && int(vaga) in vagasOnline(lojaId, dia)
                    && request.resource.data.keys().hasOnly(['criadoEm'])
                    && request.resource.data.criadoEm == request.time;
          allow update: if false;
          allow delete: if isDono() || daLoja(lojaId);
        }
      }
    }

    match /agendamentos/{codigo} {
      allow get: if resource.data.expiraEm > request.time.toMillis() || isDono() || daLoja(resource.data.lojaId);
      allow list: if isDono() || daLoja(resource.data.lojaId);

      // tutor: pedido novo, sempre junto com a trava da vaga (se a vaga já tinha dono, recusa)
      allow create: if codigo.matches('^[A-Za-z0-9]{20,40}$')
                    && request.resource.data.keys().hasOnly([
                         'lojaId', 'nomeLoja', 'logoUrl', 'cores', 'dia', 'vaga', 'status',
                         'nomeTutor', 'telefone', 'nomePet', 'especie', 'raca', 'porte', 'servico', 'obs',
                         'criadoEm', 'atualizadoEm', 'expiraEm'])
                    && request.resource.data.status == 'pendente'
                    && request.resource.data.lojaId is string
                    && agendaAtiva(request.resource.data.lojaId)
                    && request.resource.data.dia is string
                    && request.resource.data.dia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.vaga is int
                    && request.resource.data.vaga in vagasOnline(request.resource.data.lojaId, request.resource.data.dia)
                    && !exists(/databases/$(database)/documents/agendaPublica/$(request.resource.data.lojaId)/dias/$(request.resource.data.dia)/marcadas/$(string(request.resource.data.vaga)))
                    && existsAfter(/databases/$(database)/documents/agendaPublica/$(request.resource.data.lojaId)/dias/$(request.resource.data.dia)/marcadas/$(string(request.resource.data.vaga)))
                    && request.resource.data.nomeTutor is string && request.resource.data.nomeTutor.size() > 0 && request.resource.data.nomeTutor.size() <= 100
                    && request.resource.data.telefone is string && request.resource.data.telefone.matches('^[0-9]{10,13}$')
                    && request.resource.data.nomePet is string && request.resource.data.nomePet.size() > 0 && request.resource.data.nomePet.size() <= 100
                    && request.resource.data.especie in ['cao', 'gato']
                    && request.resource.data.porte in ['pequeno', 'medio', 'grande']
                    && request.resource.data.servico in ['banho', 'tosa', 'banho_tosa', 'higienica', 'ozonio', 'hidratacao']
                    && textoAte(request.resource.data.raca, 60)
                    && textoAte(request.resource.data.obs, 300)
                    && textoAte(request.resource.data.nomeLoja, 100)
                    && request.resource.data.expiraEm is int
                    && request.resource.data.expiraEm <= request.time.toMillis() + 16 * 24 * 60 * 60 * 1000;

      // tutor: só cancela (enquanto a loja ainda não recebeu o pet)
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'atualizadoEm'])
                    && resource.data.status in ['pendente', 'confirmado']
                    && request.resource.data.status == 'cancelado';

      // loja: confirma, recusa, chegada, não veio, solta a vaga de um cancelado
      allow update: if daLoja(resource.data.lojaId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'atualizadoEm', 'motivo', 'petId', 'linkTutor'])
                    && (!('linkTutor' in request.resource.data) || request.resource.data.linkTutor.matches('^[A-Za-z0-9]{20,40}$'))
                    && request.resource.data.status in ['pendente', 'confirmado', 'chegou', 'recusado', 'faltou', 'cancelado_ok']
                    && (!('motivo' in request.resource.data) || textoAte(request.resource.data.motivo, 200));
      allow delete: if isDono() || adminDaLoja(resource.data.lojaId);
    }

    // —— Contas liberadas (NOVO): e-mail de loja excluída ou acesso removido,
    //    para poder cadastrar o mesmo e-mail de novo. Só o dono.
    match /contasLivres/{email} {
      allow read, write: if isDono();
    }

    // —— Mensalidades (só o dono) —————————————————————————————————
    match /cobrancas/{cobrancaId} {
      allow read, write: if isDono();
    }

    // —— Comunicados do dono para as lojas ————————————————————————
    match /comunicados/{comunicadoId} {
      allow read: if isDono() || isStaff();
      allow write: if isDono();
    }

    // —— Raiz antiga (vazia desde 17/10): o Painel do Dono ainda consulta se há
    //    migração pendente. Só leitura, só o dono. Sai quando o site parar de consultar.
    match /petsCadastro/{petNumber} {
      allow read: if isDono();
    }

    // —— Bloqueio de coleções não previstas ——————————————————————
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
